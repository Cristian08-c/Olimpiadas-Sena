# ============================================================
# Plantilla de configuración — copiar a `.env` y rellenar
# Uso:
#   cp .env.example .env
#   editor .env   # rellenar valores reales
# ============================================================

# Flask
# Genera uno con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esto-por-un-string-aleatorio-largo

# Base de datos MySQL
DB_USER=root
DB_PASSWORD=cambia-esto
DB_HOST=localhost
DB_NAME=olimpiadas
